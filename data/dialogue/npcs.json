  "dirk_urenstaat": {
    "_comment": "Dirks slotregel na de urenstaat. Deze boom wordt niet gewandeld: ticket_controller.gd::_dirk_oordeel() kiest een node op de payload van de minigame (op_rest, lege_tickets), want dat is een getal en geen Conditions-vlag. De tekst hoort hier zodat zijn stem in de data staat en _test_karakterstemmen hem meeleest.",
    "start": "alles_geboekt",
    "nodes": {
      "veel_rest": {
        "speaker": "dirk",
        "text": "Dank je {naam}! Ik zie {rest} op overige posten staan, terwijl de verwachting daar rond het half uur ligt. Ik zet er een vraagteken bij, dan kijkt mijn collega Dennis er nog even naar. Alvast bedankt!"
      },
      "lege_tickets": {
        "speaker": "dirk",
        "text": "Dank je {naam}! Even een klein seintje: er staan nog {aantal} tickets op nul. Dan is daar niet aan gewerkt, klopt dat? Zou je ze aanvullen als er nog wat mist?"
      },
      "alles_geboekt": {
        "speaker": "dirk",
        "text": "Dank je {naam}! Helemaal op het werk zelf geboekt. Dat is netjes. Ik geef het even door aan mijn collega Dennis, die denkt graag met je mee."
      },
      "rest": {
        "speaker": "dirk",
        "text": "Dank je {naam}! {rest} op overig. Dat kan gebeuren, geen probleem hoor. Zou je het aanvullen als er nog wat mist? Alvast bedankt!"
      }
    }
  }
