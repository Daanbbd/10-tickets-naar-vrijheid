; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="10 Tickets naar Vrijheid"
config/description="Een Nederlandstalige pixel-art kantoor-RPG bij Bluebird Day."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Bus="*res://autoload/bus.gd"
GameData="*res://autoload/game_data.gd"
Session="*res://autoload/session.gd"
Shell="*res://autoload/shell.tscn"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=192
window/size/viewport_height=416
window/size/window_width_override=384
window/size/window_height_override=832
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://data/": "yellow",
"res://tools/": "purple"
}

[gui]

theme/custom_font="res://assets/fonts/ark-pixel-10px-proportional-latin.ttf"

